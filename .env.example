# ── Clés API ──────────────────────────────────────────────────────────────────

# Anthropic (génération de script)
# Obtenez votre clé sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=votre_cle_anthropic_ici

# Replicate (génération audio Qwen3-TTS et transcription)
# Obtenez votre clé sur : https://replicate.com/account/api-tokens
REPLICATE_API_KEY=votre_cle_replicate_ici

# ── Serveur Flask ──────────────────────────────────────────────────────────────
# 0.0.0.0 = accessible sur tout le LAN
HOST=0.0.0.0
PORT=5050

# HTTPS local optionnel, en parallèle du port HTTP ci-dessus
HTTPS_PORT=5051
WALLA_SSL_CERT_FILE=certs/walla-server.crt
WALLA_SSL_KEY_FILE=certs/walla-server.key

# true = adapte le texte juste avant le TTS pour forcer une diction québécoise
QUEBEC_TTS_REWRITE=false

# Modèle Replicate TTS actif
REPLICATE_TTS_MODEL=qwen/qwen3-tts:0b366549c7541af95a69454651f4ebf02c699036841cd20b78b9e2a26b4b2750

# Modèle Replicate de transcription audio
REPLICATE_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe:684265b6c4d23a4f5b3536a76e0b9e022ce5084f6da95fd7d0b5ebbc573a8261

# Protège contre le throttling Replicate quand le crédit est sous 5$.
REPLICATE_MIN_SECONDS_BETWEEN_CALLS=12

# ── Pro Tools / automatic walla ────────────────────────────────────────────
# Optional development override for a local pt_api checkout. A normal
# `pip install -r requirements.txt` installs pt_api v1.4.0 from GitHub.
# When present, a sibling folder named ../pt_api (for example Y:\pt_api next
# to Y:\walla-gen) is preferred automatically.
# PT_API_PATH=../pt_api

# ffmpeg converts TTS output to the strict 48 kHz float BWF WAV required by pt_api.
FFMPEG_EXECUTABLE=ffmpeg

# Refuse unexpectedly long walla Clip Groups before any billable generation.
WALLA_SLOT_MAX_SECONDS=120

# Template PTX préparée utilisée automatiquement par la génération walla.
WALLA_TEMPLATE_PATH=walla_template.ptx
